---
import { Font } from "astro:assets";

import BaseLayout from "./BaseLayout.astro";

import "~/styles/page.css";
import "~/styles/callouts.css";

import Footer from "~/components/Footer.astro";
import TopNavBar from "~/components/TopNavBar.astro";
import MainMenu from "~/components/MainMenu.astro";
import Logo from "~/components/Logo.astro";

const {
  title,
  description,
  bkgMode = "quiet",
  bkgQuietTarget = "article",
} = Astro.props;
---

<BaseLayout title={title} description={description} bkgMode={bkgMode} bkgQuietTarget={bkgQuietTarget}>
  <Fragment slot="head">
    <Font cssVariable="--font-baskervville" preload={[{ weight: 400, style: "normal", subset: "latin" }]} />
    <Font cssVariable="--font-smooch-sans" preload={[{ weight: 500, style: "normal", subset: "latin" }]} />
  </Fragment>
  <a class="skip-link" href="#content">Skip to content</a>
  <TopNavBar />
  <slot />
  <Footer class="footer-main-menu">
    <MainMenu aria-label="Footer menu" class="bg-drop-shadow" />
  </Footer>
  <Footer class="copyright">
    <div class="bg-drop-shadow">
      &copy; {new Date().getFullYear()} Adam Jurczyk.
      <br />
      Site content and artwork licensed under
      &nbsp;<a href="https://creativecommons.org/licenses/by-nc/4.0/" target="_blank">CC BY-NC 4.0</a>.
    </div>
    <Logo />
  </Footer>
</BaseLayout>
<style>
  .skip-link {
    position: fixed;
    top: var(--s-2);
    left: var(--s-2);
    z-index: 100;
    padding: var(--s-3) var(--s-1);
    font-family: var(--font-mono);
    color: var(--color-text);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius);
    text-decoration: none;
    transform: translateY(calc(-100% - var(--s0)));
  }
  .skip-link:focus-visible {
    transform: none;
  }

  .footer-main-menu {
    font-size: var(--s-1);
    display: flex;
    justify-content: center;
  }
  .copyright {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--s0);
    font-size: var(--s-1);
    color: var(--color-text-muted);
  }
  .copyright a {
    color: inherit;
  }
</style>