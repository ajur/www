---
const { placement = "below" } = Astro.props;
---

<theme-switcher data-placement={placement}>
  <button aria-label="Switch theme">◐</button>
</theme-switcher>

<script>
  const storageKey = "theme-preference";
  const icons: Record<string, string> = {
    light: "☀︎",
    dark: "☾",
  };
  const systemDark = window.matchMedia("(prefers-color-scheme: dark)");

  const systemTheme = () => (systemDark.matches ? "dark" : "light");
  const currentTheme = () => document.documentElement.getAttribute("data-theme") ?? systemTheme();
  const hasStoredTheme = () => ["light", "dark"].includes(localStorage.getItem(storageKey) ?? "");

  function applyTheme(theme: string) {
    document.documentElement.setAttribute("data-theme", theme);
    window.dispatchEvent(new CustomEvent("themechanged", { detail: { theme } }));
  }

  function toggleTheme() {
    const next = currentTheme() === "dark" ? "light" : "dark";
    if (next === systemTheme()) {
      localStorage.removeItem(storageKey);
    } else {
      localStorage.setItem(storageKey, next);
    }
    applyTheme(next);
  }

  systemDark.addEventListener("change", () => {
    if (!hasStoredTheme()) {
      applyTheme(systemTheme());
    }
  });

  class ThemeSwitcher extends HTMLElement {
    button = this.querySelector("button")!;

    connectedCallback() {
      this.update();
      this.button.addEventListener("click", toggleTheme);
      window.addEventListener("themechanged", this.update);
    }

    disconnectedCallback() {
      this.button.removeEventListener("click", toggleTheme);
      window.removeEventListener("themechanged", this.update);
    }

    update = () => {
      const theme = currentTheme();
      this.button.textContent = icons[theme] ?? "◐";
      this.button.setAttribute("aria-label", theme === "dark" ? "Switch to light theme" : "Switch to dark theme");
    };
  }

  customElements.define("theme-switcher", ThemeSwitcher);
</script>

<style>
  theme-switcher {
    display: inline-block;
  }
  theme-switcher button {
    all: unset;
    cursor: pointer;
    vertical-align: middle;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    inline-size: 2.5em;
    block-size: 2.5em;
    margin: -0.75em -0.4em -0.75em -0.75em;
    line-height: 1;
  }
  theme-switcher button:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }

  @media (hover: hover) {
    theme-switcher button:hover {
      color: var(--color-accent);
    }
  }
</style>
