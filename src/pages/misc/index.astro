---
import PageLayout from "~/layouts/PageLayout.astro";
import SubpageHeader from "~/components/SubpageHeader.astro";
import { getCollection } from "astro:content";

const otherPages = (await getCollection("misc")).sort(
  (a, b) => a.data.title.localeCompare(b.data.title)
);

---
<PageLayout title="Miscellaneous" bkgQuietTarget="#items-listing">
  <main class="the-center">
    <SubpageHeader title="Misc" description="A collection of things worth sharing." />

    <ul id="items-listing">
      <li>
        <a href="art/">
          <h2>Art</h2>
          <p>Gallery of my drawings and sometimes other forms of visual art that I do as a hobby.</p>
        </a>
      </li>
      {otherPages.map((page) => (
        <li>
          <a href={`/misc/${page.id}/`}>
            <h2>{page.data.title}</h2>
            {page.data.description && <p>{page.data.description}</p>}
          </a>
        </li>
      ))}
      <li>
        <a href="/tags/">
          <h2>Tags</h2>
          <p>Listing page for all used content tags.</p>
        </a>
      </li>
    </ul>
  </main>
</PageLayout>

<style>
  main {
    padding-inline: var(--s0);
  }

  ul {
    list-style: none;
    padding: 0;
    margin: 0;
    inline-size: 100%;
    max-inline-size: var(--measure);
  }

  a {
    display: block;
    padding-block: var(--s1);
    padding-inline: var(--s-1);
    border-top: 1px solid var(--color-border);
    text-decoration: none;
    color: inherit;
  }

  a:hover,
  a:focus-visible {
    color: var(--color-link);
  }

  h2 {
    font-size: var(--s1);
    margin: 0;
  }

  p {
    margin: 0;
    margin-top: var(--s-3);
  }
</style>